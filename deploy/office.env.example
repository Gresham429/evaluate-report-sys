# 办公端联钉钉多维表 · 部署配置模板
#
# 用法：把本文件复制成 `.env`、填好真实值，放在 **exe 所在目录**（与 exe 同一层）。
# 程序启动时会读它（见 __main__._load_dotenv → app_dir/.env），据此连公司钉钉多维表。
# 不放 .env / 值不全 → 走本地模式：出报告能用，但「从实勘问卷拉取 / 审核 / 扫码登录」用不了。
#
# ⚠️ 含 app secret，属敏感文件：只在公司内部分发到估价师机器，**绝不要**提交进 git、
#    也不要放进 GitHub Release 资产。真实 .env 已在 .gitignore 里。
# 交付包里带的是本模板（`.env.example`，非敏感）；填好的那份由内部另发。

# —— 总开关：设成「多维表」才联钉钉；留空/删掉 = 本地模式 ——
承载后端=多维表

# —— 钉钉企业内部应用凭据（网页扫码登录 + 多维表读写共用同一套）——
YIDA_APP_KEY=你的AppKey
YIDA_APP_SECRET=你的AppSecret          # 唯一真正敏感的值

# —— 多维表（base）与操作人 ——
NOTABLE_BASE_ID=多维表baseId
NOTABLE_OPERATOR_ID=操作人unionId       # 多维表 API 用（unionId，非 userid）

# —— 四张表的 sheetId ——
NOTABLE_SURVEY_SHEET=实勘问卷sheetId
NOTABLE_INSTANCE_SHEET=实例库sheetId
NOTABLE_BASETABLE_SHEET=基础表sheetId
NOTABLE_LEDGER_SHEET=台账sheetId

# —— 权限 ——
# 管理员 userid 名单（逗号/空格分隔）：名单内的人办公端可看全部问卷；名单外只看自己（含被加为共有人的）。
OFFICE_ADMINS=

# 扫码登录回调地址：须与钉钉后台「安全设置→重定向URL」登记的一字不差。
# 默认本机 http://127.0.0.1:8765/auth/callback（已登记），换端口/形态才需改。
# OFFICE_LOGIN_REDIRECT=http://127.0.0.1:8765/auth/callback

# 说明：不设 OFFICE_OPERATOR_ID——办公端登录后由登录身份决定「你是谁」；不登录则看不到任何问卷（fail-closed）。
