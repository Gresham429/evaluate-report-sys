# 案例素材与金样（约 100MB，本地保存，不入库）
案例素材/
tests/goldens/*.docx
tests/goldens/*.xlsx

# 运行期数据：估价师本机产生的基础表版本、草稿、生成台账，可能含真实客户信息，
# 绝不入库。data/实例库.json 是显式跟踪的种子数据（见下方 !），不受这条影响。
data/基础表/
data/草稿/
data/生成台账/
!data/实例库.json

# 环境
.env

# 运行期登录会话（userid+名字，非密钥）——本机保持登录用，不入库
登录会话.json

# 构建产物
dist/
build/
*.spec

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# SDD 临时产物。progress.md 是恢复用的进度账本，须入库。
.superpowers/sdd/*-brief.md
.superpowers/sdd/*-report.md
.superpowers/sdd/*.diff

# 系统
.DS_Store

# FC 部署产物(构建生成,不入库)
serverless/dist/

# 钉钉小程序 CLI:ding.config.json 含 API token(短期凭证),勿入库;构建产物同理
miniprogram/ding.config.json
miniprogram/dist/
miniprogram/.dev/
