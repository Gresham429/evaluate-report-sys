<view class="card">
  <view>现场拍照</view>
  <view class="muted">照片先存本机，联网自动补传。（地图预填在「逐因素采集」页）</view>
</view>

<view class="card">
  <button class="btn-primary" onTap="onChoose">拍照 / 选图</button>
  <view class="grid">
    <view class="thumb" a:for="{{photos}}" key="p{{index}}">
      <image class="img" src="{{item}}" mode="aspectFill" />
      <view class="del" data-i="{{index}}" onTap="onDelPhoto">×</view>
      <view class="tag ok">已传</view>
    </view>
    <view class="thumb" a:for="{{pending}}" key="q{{index}}">
      <image class="img" src="{{item.path}}" mode="aspectFill" />
      <view class="del" data-i="{{index}}" onTap="onDelPending">×</view>
      <view class="tag wait">待传</view>
    </view>
  </view>
</view>

<view class="card">
  <button class="btn-primary" onTap="onDone">完成，返回表单</button>
  <view class="muted" a:if="{{msg}}">{{msg}}</view>
</view>
