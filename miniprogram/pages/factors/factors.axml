<view class="card" a:if="{{!category}}">
  <view class="muted">请先回表单选择类别，再填逐因素。</view>
</view>

<view class="card" a:if="{{category}}">
  <button class="btn-primary" onTap="onGeo">地图预填地理事实</button>
  <view a:if="{{geo.address}}">
    <view>地址：{{geo.address}}</view>
    <view class="muted">公交：{{geo.bus_stops}}</view>
    <view class="muted">最近地铁：{{geo.metroText}}</view>
    <view class="muted" a:if="{{geo.centerText}}">行政中心：{{geo.centerText}}</view>
    <view class="muted" a:if="{{geo.highwayText}}">最近高速口：{{geo.highwayText}}</view>
    <view class="muted" a:if="{{geo.waterText}}">最近水源：{{geo.waterText}}</view>
    <view class="muted" a:if="{{geo.parkingText}}">停车场：{{geo.parkingText}}</view>
    <view class="muted" a:if="{{geo.roadsText}}">{{geo.roadsText}}</view>
    <view class="muted">周边：{{geo.facilities}}</view>
  </view>
  <view class="muted">已自动填入对应区位因素的描述（只填空、可改）；档次仍由你判断。</view>
</view>

<block a:for="{{groups}}" a:for-item="grp" key="{{grp.section}}">
  <view class="card">
    <view class="sec">{{grp.section}}</view>
    <view class="fac" a:for="{{grp.items}}" a:for-item="item" key="{{item.name}}">
      <text class="name">{{item.name}}</text>
      <picker range="{{item.levels}}" data-name="{{item.name}}" onChange="onLevel">
        <view class="pick">{{levels[item.name] || '选档次'}}</view>
      </picker>
      <textarea class="desc" value="{{descs[item.name]}}" data-name="{{item.name}}" onInput="onDesc" placeholder="现场描述" auto-height show-count="{{false}}" />
    </view>
  </view>
</block>

<view class="card" a:if="{{category}}">
  <button class="btn-primary" onTap="onDone">完成，返回表单</button>
</view>
