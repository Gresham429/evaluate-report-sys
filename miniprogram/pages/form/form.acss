.row { display: flex; align-items: center; padding: 12rpx 0; }
.label { width: 200rpx; color: #555; }
.inp, .pick { flex: 1; border: 1rpx solid #ddd; border-radius: 6rpx; padding: 10rpx; }
.unsynced { color: #d4700a; font-size: 26rpx; padding: 6rpx 0; }
.synced { color: #1a7f37; font-size: 26rpx; padding: 6rpx 0; }
